# ============================================================
# AI-Powered Banking Customer Intelligence Platform
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ============================================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_intelligence
DB_USER=postgres
DB_PASSWORD=your_password_here

# Convenience full URL (SQLAlchemy format)
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/banking_intelligence

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini       # Use gpt-4o for best results; gpt-4o-mini is faster/cheaper

# --- App ---
APP_ENV=development             # development | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# --- Data Paths ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# --- Model Settings ---
RANDOM_SEED=42
